# Copy to .env and fill in. Every variable is validated by src/env.ts.
# (Comments are on their own lines: Node's --env-file parser and dotenv
# disagree on inline comments.)

DATABASE_URL=postgres://secwire:secwire@localhost:5432/secwire

# Admin login password (≥ 8 chars). Placeholder values are rejected in production.
ADMIN_PASSWORD=change-me

# Signs the admin session cookie. ≥ 32 chars, e.g. `openssl rand -base64 48`.
SESSION_SECRET=generate-a-32+-char-random-string

# Bearer token for POST /api/ingest (≥ 16 chars), e.g. `openssl rand -hex 32`.
INGEST_API_TOKEN=generate-a-random-token

# Optional; raises the NVD rate limit from 5 to 50 requests / 30s.
NVD_API_KEY=

# Identifies SecWire to the sites it fetches. Put a contact URL or address here.
FETCH_USER_AGENT=SecWire/0.1 (+mailto:you@example.com)

KEV_ITEM_LOOKBACK_DAYS=14
CLUSTER_WINDOW_DAYS=14

# Deployment-level kill switch; false = rely on external POST /api/ingest.
# Interval and on/off are admin settings in the DB (SPEC §7.5), not env vars.
WORKER_SCHEDULES_ENABLED=true

# --- Phase 3 ---------------------------------------------------------------
# X (pay-per-use API). Off unless X_ENABLED=true and a bearer token is set.
# Each fetch is refused when this month's spend + its worst case would exceed the cap.
X_ENABLED=false
X_BEARER_TOKEN=
X_MONTHLY_CAP_USD=10
X_POST_READ_USD=0.005             # per post returned (docs.x.com pricing, 2026-11)

# AI story summaries (one per story cluster, regenerated only when items join).
# Off unless ANTHROPIC_API_KEY is set; refused once the monthly cap would be crossed.
ANTHROPIC_API_KEY=
SUMMARY_MODEL=claude-haiku-5-5
SUMMARY_MIN_ITEMS=2
AI_MONTHLY_CAP_USD=5
# Only for a SUMMARY_MODEL missing from the built-in price table (USD per million tokens):
# AI_INPUT_USD_PER_MTOK=
# AI_OUTPUT_USD_PER_MTOK=

# Watchlist alerts. A channel is available when its settings are present.
APP_URL=                          # public base URL, for story links in alerts (e.g. https://secwire.example.com)
SLACK_WEBHOOK_URL=                # https://hooks.slack.com/services/...
SMTP_URL=                         # smtp(s)://user:pass@host:port
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=                   # comma-separated
